{
  "name": "docshift",
  "version": "0.1.0",
  "private": true,
  "description": "浏览器端文档格式转换工具：Word / Markdown / HTML / 纯文本互转，文件不上传服务器",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && python3 -m http.server 4173 --directory dist",
    "preview": "node build.mjs && python3 -m http.server 4173 --directory dist"
  },
  "keywords": [
    "docx",
    "markdown",
    "html",
    "converter",
    "client-side",
    "privacy"
  ],
  "license": "MIT",
  "dependencies": {
    "docx": "^8.5.0",
    "mammoth": "^1.13.0",
    "marked": "^12.0.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.23.1"
  }
}
